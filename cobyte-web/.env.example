# Copie para .env.local no desenvolvimento.
# Na Vercel, configure a URL HTTPS do túnel (sem /api e sem barra final).
# Esta variável é pública e incorporada no build: alterações exigem redeploy.
VITE_API_URL=http://localhost:8080
# Opcional. Endereço público de contato do suporte.
VITE_EMAIL_SUPORTE=

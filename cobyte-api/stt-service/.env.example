# Configurações do STT Service (Cobyte)
STT_DEVICE=cpu
STT_MODEL_PATH=./models/small
STT_MAX_BYTES=10485760
STT_MAX_DURATION_SECONDS=600

# Parâmetros de Inferência
STT_BEAM_SIZE=5
STT_TEMPERATURE=0.0

# Servidor HTTP
STT_HOST=127.0.0.1
STT_PORT=8000
# Compartilhe com o backend via STT_INTERNAL_API_KEY; pelo menos 32 bytes aleatórios.
# Este arquivo é referência: exporte as variáveis no terminal antes de iniciar.cmd.
STT_INTERNAL_API_KEY=
# Apenas para desenvolvimento: permite ausência de chave se o host E o cliente forem loopback.
STT_ALLOW_LOCAL_WITHOUT_KEY=false
